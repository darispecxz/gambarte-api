APP_NAME=CgrApi
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/La_Paz

# Binance Pay account history (read-only USER_DATA key; keep the secret on the API server only).
BINANCE_PAY_HISTORY_API_BASE=https://api.binance.com
BINANCE_PAY_HISTORY_API_KEY=
BINANCE_PAY_HISTORY_API_SECRET=
# Binance account UID that should receive the customer payments (receiverInfo.binanceId).
BINANCE_PAY_HISTORY_RECEIVER_ID=

LOG_CHANNEL=single
LOG_LEVEL=error

# Base de datos CGR (back office cambios)
DB_CGR_HOST=127.0.0.1
DB_CGR_PORT=3306
DB_CGR_DATABASE=u752765750_cgr
DB_CGR_USERNAME=
DB_CGR_PASSWORD=

# Base de datos Contabilidad (FacturaScripts)
DB_CONTA_HOST=127.0.0.1
DB_CONTA_PORT=3306
DB_CONTA_DATABASE=u752765750_conta
DB_CONTA_USERNAME=
DB_CONTA_PASSWORD=

# Base de datos Chile (Gambarte Chile)
DB_CHILE_HOST=127.0.0.1
DB_CHILE_PORT=3306
DB_CHILE_DATABASE=u738243979_gmb
DB_CHILE_USERNAME=
DB_CHILE_PASSWORD=
CHILE_SYNC_PAUSADO=true

# Sistema CGR legacy (URLs de comprobantes y archivos)
CGR_PUBLIC_URL=
CGR_PUBLIC_PATH=

# Servicio SIAT (facturación electrónica - Java Spring Boot)
SIAT_BASE_URL=http://localhost:8080/api

# API Chile (cotización CLP/USD)
CHILE_API_URL=

# CORS: orígenes permitidos, separados por coma
CORS_ALLOWED_ORIGINS=https://tusitio.com

# JWT Authentication
JWT_SECRET=
JWT_TTL=3600
JWT_ALGO=HS256
JWT_ISSUER=cgrapi

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
